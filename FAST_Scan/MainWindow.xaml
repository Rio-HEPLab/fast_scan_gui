<Window x:Class="FAST_Scan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FAST_Scan"
        xmlns:viewModel="clr-namespace:FAST_Scan.MVVM.ViewModel"
        mc:Ignorable="d"
        Title="FAST SCAN" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ThreeDBorderWindow"
        Background="LightGray"
        Icon="/Images/FAST_SCAN_Icon.png"
        Closing="Window_Closing"
        ResizeMode="CanResize"
        MinHeight="700"
        MinWidth="1000">

    <Window.DataContext>
        <viewModel:MainViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Background="#070726">
            <Grid.RowDefinitions>
                <RowDefinition Height="5*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Column="0"
                        >

                <Image Source="/Images/FAST_LOGO.png"
                       Width="180"
                       Margin="10"/>

                <RadioButton Content="2D Scan"
                             FontFamily="BahnSchrift Bold"
                             Height="50"
                             Style="{StaticResource MenuButtonTheme}"
                             Command="{Binding Scan2DCommand}"/>

                <RadioButton Content="1D Scan"
                             Height="50"
                             Style="{StaticResource MenuButtonTheme}"
                             Command="{Binding Scan1DCommand}"/>

                <RadioButton Content="Focal Analysis"
                             Height="50"
                             Style="{StaticResource MenuButtonTheme}"/>

                <RadioButton Content="Waveform Plot"
                             Height="50"
                             Style="{StaticResource MenuButtonTheme}"
                             Command="{Binding WaveformViewerCommand}"/>

                <RadioButton Content="Time Resolution"
                             Height="50"
                             Style="{StaticResource MenuButtonTheme}"
                             Command="{Binding TimeResolutionCommand}"/>

                <RadioButton Content="Open Scan File"
                             Height="50"
                             Style="{StaticResource MenuButtonTheme}"/>
            </StackPanel>
            
            <Button Grid.Row="1"
                    Height="50"
                    VerticalAlignment="Bottom"
                    Foreground="#4053A0"
                    BorderBrush="Transparent"
                    Command="{Binding ConfigurationsCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <!-- cor normal -->
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>

                        <!-- Template customizado -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="5">
                                        <ContentPresenter
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1E203A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE115;"
                               FontSize="25"
                               Margin="5"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Configurations"
                               FontFamily="Source Sans Variable"
                               FontWeight="Bold"
                               FontSize="20"
                               Margin="5"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
        

        <Grid Grid.Column="1"
              Background="White">
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="5*"
                               MinHeight="400"/>
                <RowDefinition Height="3*"/>
            </Grid.RowDefinitions>

            <Image Source="/Images/FAST_SCAN_Logo.png"
                   Grid.Column="1"
                   Grid.Row="0"
                   Grid.RowSpan="2"
                   Margin="30"
                   />

            <TextBlock x:Name="TestModeText"
                       Text="TestMode"
                       FontSize="80"
                       Grid.Column="1"
                       Grid.Row="0"
                       Grid.RowSpan="2"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="Red"
                       Background="Black"/>

            <ContentControl Grid.Row="0"
                        Content="{Binding CurrentView}"/>

            <ContentControl Grid.Row="1"
                            Content="{Binding TerminalView}"/>
        </Grid>

    </Grid>
</Window>
