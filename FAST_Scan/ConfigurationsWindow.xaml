<Window x:Class="FAST_Scan.ConfigurationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FAST_Scan"
        mc:Ignorable="d"
        Icon="/Images/FAST_SCAN_Icon.png"
        ResizeMode="NoResize"
    Title="ConfigurationsWindow" Height="600" Width="800" >
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Grid Background="#070726"
              Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
            Grid.Column="0">
                <TextBlock Text="&#xE115;"
               FontSize ="25"
               FontFamily="Segoe MDL2 Assets"     
               FontWeight="Normal"
               Foreground="White"
               VerticalAlignment="Center"
               Margin="10,0,0,0"/>
                <TextBlock Text="Configurations"
               FontSize ="20"
               FontFamily="Source Sans Variable"
               FontWeight="Bold"
               Foreground="White"
               Margin="10"
               VerticalAlignment="Center"/>
            </StackPanel>

            <Image HorizontalAlignment="Right"
                   Source="/Images/FAST_LOGO.png"
                   Grid.Column="1"
                   Margin="8"/>
        </Grid>
        

        <ScrollViewer FontFamily="Source Sans Variable"
                      FontSize="15"
                      Padding="10"
                      Grid.Row="1">
            <StackPanel>
                <TextBlock Text="S Curve Fit Initial Parameters"
                           FontWeight="Bold"
                           Margin="5"/>
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Sigma (&#x03C3;)"
                               Grid.Column="0"
                               Grid.Row="0"
                               Margin="5,0,0,0"/>
                    <TextBox x:Name="CurveFitSigma"
                             Grid.Row="1"
                             Grid.Column="0"
                             Margin="5"/>
                    <TextBlock Text="Multiplicative Factor (I)"
                               Grid.Column="1"
                               Grid.Row="0"
                               Margin="5,0,0,0"/>
                    <TextBox x:Name="CurveFitI"
                             Grid.Row="1"
                             Grid.Column="1"
                             Margin="5"/>
                    <TextBlock Text="Additive Factor (C)"
                               Grid.Column="2"
                               Grid.Row="0"
                               Margin="5,0,0,0"/>
                    <TextBox x:Name="CurveFitC"
                             Grid.Row="1"
                             Grid.Column="2"
                             Margin="5"/>
                    <TextBlock Grid.Column="3"
                                Grid.Row="0"
                                Margin="5,0,0,0" Height="18" VerticalAlignment="Top">
                        <Run Text="X Shift Factor (x"/>
                        <Run Text="0"
                             BaselineAlignment="Subscript"
                             FontSize="10"/>
                        <Run Text=")"/>
                    </TextBlock>
                    <TextBox x:Name="CurveFitX0"
                             Grid.Row="1"
                             Grid.Column="3"
                             Margin="5"/>
                </Grid>

                <TextBlock Text="Servo Motors Configurations"
                           FontWeight="Bold"
                           Margin="5,20,5,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Servo X Serial Number"
                               Grid.Row="0"
                               Grid.Column="0"
                               Margin="5,0,0,0"/>
                    <TextBox x:Name="ServoX_SN"
                             Grid.Row="1"
                             Grid.Column="0"
                             Margin="5"/>
                    <TextBlock Text="Servo Y Serial Number"
                               Grid.Row="0"
                               Grid.Column="1"
                               Margin="5,0,0,0"/>
                    <TextBox x:Name="ServoY_SN"
                             Grid.Row="1"
                             Grid.Column="1"
                             Margin="5"/>
                    <TextBlock Text="Servo Z Serial Number"
                               Grid.Row="0"
                               Grid.Column="2"
                               Margin="5,0,0,0"/>
                    <TextBox x:Name="ServoZ_SN"
                             Grid.Row="1"
                             Grid.Column="2"
                             Margin="5"/>
                </Grid>

                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Servos Speed (mm/s)"
                               Grid.Row="0"
                               Grid.Column="0"
                               Margin="5,0,0,0"
                               VerticalAlignment="Bottom"/>
                    <TextBox x:Name="ServoSpeed"
                             Grid.Row="1"
                             Grid.Column="0"
                             Margin="5"/>
                    <TextBlock Grid.Row="0"
                                Grid.Column="1"
                                Margin="5,0,0,0">
                        <Run Text="Servos Acceleration (mm/s"/>
                        <Run Text="2"
                             BaselineAlignment="Superscript"
                             FontSize="10"/>
                        <Run Text=")"/>
                    </TextBlock>
                    <TextBox x:Name="ServoAcceleration"
                             Grid.Row="1"
                             Grid.Column="1"
                             Margin="5"/>
                </Grid>
                
                <TextBlock Text="Digitizer Library Path"
                           FontWeight="Bold"
                           Margin="5,20,5,5"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox Margin="5"
                            Width="500"/>
                    <Button Content="Search"
                            Margin="5"
                            Padding="5,0"/>
                </StackPanel>

                <TextBlock Text="Osciloscope Library Path"
                           FontWeight="Bold"
                           Margin="5,20,5,5"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox Margin="5"
                            Width="500"/>
                    <Button Content="Search"
                            Margin="5"
                            Padding="5,0"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
        
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button Width="100"
                    Content="Save"
                    Margin="15"
                    Command="{Binding SaveCommand}"/>
            <Button Content="Cancel"
                    Width="100"
                    Margin="15"
                    Command="{Binding CancelCommand}"/>

        </StackPanel>
    </Grid>
</Window>
